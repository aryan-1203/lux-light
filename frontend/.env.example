# Copy to .env.local for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Cloudflare Turnstile site key (dev test key that always passes: 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Analytics: plausible | ga4 | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=
# On Vercel: NEXT_PUBLIC_SITE_URL = your domain, NEXT_PUBLIC_API_URL = your Render service URL (see README §2).
