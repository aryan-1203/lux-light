# Dawnlit frontend — Vite env (local dev).   cp frontend/.env.example frontend/.env.local
# Every VITE_* value is compiled into the public JS bundle: never put secrets here.
# Docker builds take these as build args from the root .env (docker-compose.yml → frontend.build.args).

# true → Mock Service Worker answers every /api call in the browser (no backend needed).
# false → real API through the Vite proxy (/api, /media, /sitemap.xml, /robots.txt → :8000).
VITE_API_MOCK=false

# Canonical site URL for meta/OG/JSON-LD. Production: https://<your-domain>
VITE_SITE_URL=http://localhost:5173

# Optional React Three Fiber hero (lazy-loaded with a static fallback).
VITE_ENABLE_3D=false

# Analytics placeholders (no-op while empty). Before enabling: consent banner + CSP update in
# frontend/nginx.conf (docs/LAUNCH_CHECKLIST.md → Analytics). Example formats: G-XXXXXXXXXX / 15-16 digits.
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Dev/preview proxy target (read by vite.config.ts from the shell environment, not from this file's
# VITE_ namespace at runtime). Default http://127.0.0.1:8000.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
