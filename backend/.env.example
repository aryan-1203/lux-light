# Copy to .env for local development. Never commit .env.
APP_ENV=development
# Comma-separated list of allowed frontend origins (exact scheme + host + port, no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Google Sheets: base64 of the service-account JSON (see README → Google Cloud setup).
# Leave empty locally: submissions then go straight to the outbox.
GOOGLE_SERVICE_ACCOUNT_B64=
# Either one spreadsheet holding both tabs (SHEET_ID), or one spreadsheet each (these two override SHEET_ID).
# The key is the part of the URL between /d/ and /edit. Share each spreadsheet with the service account as Editor.
SHEET_ID=
LEADS_SHEET_ID=
NEWSLETTER_SHEET_ID=
LEADS_TAB=Leads
NEWSLETTER_TAB=Newsletter
# Request-time retries on Sheets 429/5xx/network errors (delays ~0.5s, 1s, 2s), then outbox
SHEETS_REQUEST_RETRIES=3
SHEETS_BACKOFF_BASE_SECONDS=0.5
SHEETS_TIMEOUT_SECONDS=10
# Seconds the in-memory phone/email dedupe index is trusted before re-reading the sheet
SHEETS_INDEX_TTL_SECONDS=120

# Cloudflare Turnstile secret (dev test secret that always passes: 1x0000000000000000000000000000000AA).
# Empty = verification skipped in development, but every lead is REJECTED when APP_ENV=production.
TURNSTILE_SECRET=

# Durable outbox (on Render, point this at the persistent disk: /var/data/outbox.sqlite3)
OUTBOX_PATH=./data/outbox.sqlite3
OUTBOX_WORKER_ENABLED=true
# Drain interval and per-item backoff base (seconds); backoff is capped at OUTBOX_BACKOFF_CAP_SECONDS
OUTBOX_RETRY_SECONDS=30
OUTBOX_BACKOFF_CAP_SECONDS=1800

# Per-IP rate limits (slowapi syntax)
RATE_LIMIT_LEADS=5/minute
RATE_LIMIT_NEWSLETTER=10/minute

# Max request body in bytes (bigger → 413)
MAX_BODY_BYTES=16384
