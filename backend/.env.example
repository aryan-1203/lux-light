# =============================================================================================
# Dawnlit backend — local development WITHOUT Docker.   cp backend/.env.example backend/.env
# =============================================================================================
# Loaded by pydantic-settings from backend/.env (app/core/config.py); real environment variables
# win over this file. Commented variables use the safe local default from config.py.
# Database: infra/local/mysql.sh start → MySQL on 127.0.0.1:3307 (root, no password).
#
# Legend
#   [PROD-REQUIRED]  the owner MUST provide a real value before going live; ENV=production refuses
#                    to start (or seeding refuses) with the dev placeholder.
#   [OWNER]          business detail the owner must fill before launch (shown on invoices/pages).
#
# Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave numeric/boolean lines commented instead of writing `NAME=` (empty values fail validation).
# For Docker use the root .env.example instead.
# =============================================================================================

# ----- Core ------------------------------------------------------------------------------------
# development | test | production. production ⇒ Secure cookies, JSON logs, API docs off, strict
# validation of secrets and payment settings.
ENV=development

# [PROD-REQUIRED] JWT signing / cookie-signing key, ≥ 32 random chars. Rotating it logs everyone out.
# SECRET_KEY=change-me

# SQLAlchemy URL (PyMySQL driver). Local isolated MySQL from infra/local/mysql.sh:
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3307/luxlight
# pytest only — the database name MUST end in _test (tests drop and recreate every table).
TEST_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3307/luxlight_test
# Optional. Empty → in-memory rate limiter (fine for a single local process).
REDIS_URL=

# Browser origins allowed by CORS (comma list, no trailing slash): Vite dev (:5173) + preview (:4173),
# both of which proxy /api to :8000 (same origin). Production: https://<your-domain>
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Absolute site URL used in sitemap.xml, canonical links, emails. Production: https://<your-domain>
PUBLIC_SITE_URL=http://localhost:5173
# Cookie domain (empty = host-only cookie; recommended unless you share cookies across subdomains).
COOKIE_DOMAIN=
# Swagger UI at /api/docs. Default: on outside production, off in production.
# API_DOCS_ENABLED=true

# ----- Brand & seller (shown on invoices, emails, legal pages) --------------------------------
# Rename = this + frontend/src/config/brand.ts (README → "Renaming the brand").
BRAND_NAME=Dawnlit
# [OWNER] Registered legal entity name (Pvt Ltd / LLP / proprietorship) exactly as on the GST certificate.
BRAND_LEGAL_NAME=Dawnlit (placeholder legal name)
# [OWNER] 15-character GSTIN. The default is a format-valid PLACEHOLDER, not a real registration.
SELLER_GSTIN=27AAAAA0000A1Z5
# [OWNER] GST state code of the registered place of business (27 = Maharashtra). Drives CGST/SGST vs IGST.
SELLER_STATE_CODE=27
# [OWNER] Registered business address printed on invoices.
SELLER_ADDRESS=Placeholder address, Mumbai, Maharashtra 400001, India
# [OWNER] Customer-care contacts (also required on listings by Legal Metrology rules).
SUPPORT_EMAIL=support@dawnlit.in
SUPPORT_PHONE=+910000000000
# Internal address for low-stock / failed-job alerts.
ADMIN_ALERT_EMAIL=alerts@dawnlit.in
# Writable directory for media/ (public product images), invoices/ (private PDFs) and outbox/
# (mock email/WhatsApp). Default: backend/storage (gitignored).
# STORAGE_DIR=./storage

# ----- Payments (Razorpay) ---------------------------------------------------------------------
# mock | razorpay. With PAYMENT_PROVIDER=razorpay and empty keys the app falls back to the mock
# gateway (logged at startup). Production requires razorpay + all three values below.
PAYMENT_PROVIDER=mock
# [PROD-REQUIRED] Razorpay Dashboard → Account & Settings → API Keys. Test keys start with
# rzp_test_, live keys with rzp_live_. Never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [PROD-REQUIRED] Secret you choose when creating the webhook (Dashboard → Webhooks) for
# https://<your-domain>/api/v1/payments/webhook/razorpay — generate it with the command above.
RAZORPAY_WEBHOOK_SECRET=
# [PROD-REQUIRED] HMAC secret of the local mock gateway. Must differ from the dev placeholder in
# production even though the mock is disabled there.
# MOCK_PAYMENT_SECRET=change-me

# ----- Shipping (Shiprocket) -------------------------------------------------------------------
# Empty email/password → mock courier (instant AWB, simulated tracking).
# [PROD-REQUIRED for real shipping] Shiprocket API user (Settings → API → Create API User).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as configured in Shiprocket → Settings → Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=
# [PROD-REQUIRED] Value the courier must send in the X-Webhook-Token header to
# https://<your-domain>/api/v1/shipping/webhook/shiprocket. Generate with the command above.
# SHIPPING_WEBHOOK_TOKEN=change-me

# ----- Email (SMTP) ----------------------------------------------------------------------------
# Empty SMTP_HOST → emails are written to STORAGE_DIR/outbox (mock). [PROD-REQUIRED] for real mail:
# your transactional provider's SMTP relay (SES, Postmark, SendGrid, Zoho, …).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be a sender on a domain with SPF + DKIM + DMARC configured.
SMTP_FROM=Dawnlit <no-reply@dawnlit.in>
SMTP_STARTTLS=true

# ----- WhatsApp (provider-agnostic HTTP adapter) -----------------------------------------------
# Empty → mock (messages logged to notifications_log / outbox). [PROD-REQUIRED for WhatsApp]
# endpoint + API key of your WhatsApp Business API provider (Gupshup, Interakt, Twilio, 360dialog …);
# message templates must be pre-approved by Meta.
WHATSAPP_PROVIDER_URL=
WHATSAPP_API_KEY=

# ----- Commerce rules (integer paise; ₹1 = 100 paise) ------------------------------------------
FREE_SHIPPING_THRESHOLD_PAISE=99900
SHIPPING_FEE_PAISE=7900
COD_FEE_PAISE=4900
COD_MAX_ORDER_PAISE=1000000
# Minutes a checkout holds stock before the reservation expires.
RESERVATION_TTL_MINUTES=15
MAX_QTY_PER_LINE=5

# ----- Auth ------------------------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Echo OTP codes in API responses — tests/E2E only; ignored in production.
OTP_DEV_ECHO=false
RATE_LIMIT_ENABLED=true

# ----- Seed users (python -m app.seeds) --------------------------------------------------------
# Local defaults (when commented): admin@dawnlit.in + staff@dawnlit.in → ChangeMe!2026,
# demo customers priya.demo@example.com / arjun.demo@example.com → DemoPass!2026.
# [PROD-REQUIRED] strong unique passwords before seeding production (seeding refuses the defaults).
# SEED_ADMIN_PASSWORD=change-me
# SEED_STAFF_PASSWORD=change-me
# SEED_DEMO_PASSWORD=change-me

# ----- Logging ---------------------------------------------------------------------------------
LOG_LEVEL=INFO
# JSON log lines (default: true in production, false otherwise).
# LOG_JSON=false
